@inject IJSRuntime JS
@inject IOptionsMonitor<PlayerConfig> PlayerConfig
@implements IAsyncDisposable

@if (_visible)
{
    <div class="player-fab-wrap">
        <div class="player-card @(_expanded ? "expanded" : "") @(_isPlaying ? "playing" : "")">

            @if (_expanded)
            {
                <div class="player-card__inner">
                    <div class="player-cover-wrap">
                        @if (!string.IsNullOrEmpty(CurrentTrack?.Cover))
                        {
                            <img class="player-cover" src="@CurrentTrack.Cover" alt="cover" />
                        }
                        else
                        {
                            <div class="player-cover-placeholder">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z" />
                                </svg>
                            </div>
                        }
                    </div>

                    <div class="player-info">
                        <p class="player-title">@(CurrentTrack?.Title ?? "—")</p>
                        <p class="player-artist">@(CurrentTrack?.Artist ?? "—")</p>
                    </div>

                    <div class="player-progress-wrap">
                        <input type="range"
                        class="player-progress"
                        min="0"
                        step="0.1"
                        @ref="_progressRef" />
                        <div class="player-time">
                            <span>@FormatTime(_currentTime)</span>
                            <span>@FormatTime(_duration)</span>
                        </div>
                    </div>

                    <div class="player-controls">
                        <button class="player-btn @(_shuffle ? "active" : "")"
                        @onclick="ToggleShuffle" title="Shuffle">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M10.59 9.17L5.41 4 4 5.41l5.17 5.17 1.42-1.41zM14.5 4l2.04 2.04L4 18.59 5.41 20 17.96 7.46 20 9.5V4h-5.5zm.33 9.41l-1.41 1.41 3.13 3.13L14.5 20H20v-5.5l-2.04 2.04-3.13-3.13z" />
                            </svg>
                        </button>
                        <button class="player-btn" @onclick="Prev">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M6 6h2v12H6zm3.5 6l8.5 6V6z" />
                            </svg>
                        </button>
                        <button class="player-btn player-btn--main" @onclick="Toggle">
                            @if (_isPlaying)
                            {
                                <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
                                </svg>
                            }
                            else
                            {
                                <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M8 5v14l11-7z" />
                                </svg>
                            }
                        </button>
                        <button class="player-btn" @onclick="Next">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" />
                            </svg>
                        </button>
                        <div class="player-volume-wrap">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z" />
                            </svg>
                            <input type="range"
                                class="player-volume"
                                min="0" max="1" step="0.01"
                                @ref="_volumeRef" />
                        </div>
                    </div>

                    @if (_tracks.Count > 1)
                    {
                        <div class="player-tracklist">
                            @for (int i = 0; i < _tracks.Count; i++)
                            {
                                var idx = i;
                                var track = _tracks[i];
                                <div class="player-track @(idx == _currentIndex ? "active" : "")"
                                @onclick="() => SelectTrack(idx)">
                                    <span class="player-track__title">@track.Title</span>
                                    <span class="player-track__artist">@track.Artist</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            <button class="player-fab" @onclick="ToggleExpand">
                @if (_isPlaying)
                {
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z" />
                    </svg>
                }
                else
                {
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z" />
                    </svg>
                }
            </button>
        </div>
    </div>
}

@code {
    private bool _visible = false;
    private bool _expanded = false;
    private bool _isPlaying = false;
    private bool _shuffle = false;
    private double _currentTime = 0;
    private double _duration = 0;
    private double _volume = 0.5;
    private int _currentIndex = 0;
    private List<TrackInfo> _tracks = new();
    private DotNetObjectReference<MusicPlayer>? _dotnetRef;

    private ElementReference _progressRef;
    private ElementReference _volumeRef;

    private TrackInfo? CurrentTrack =>
        _tracks.Count > _currentIndex ? _tracks[_currentIndex] : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!PlayerConfig.CurrentValue.Enabled) return;

        _volume = PlayerConfig.CurrentValue.Volume;
        _shuffle = PlayerConfig.CurrentValue.Shuffle;
        _dotnetRef = DotNetObjectReference.Create(this);

        var config = new
        {
            volume = PlayerConfig.CurrentValue.Volume,
            autoplay = PlayerConfig.CurrentValue.Autoplay,
            shuffle = PlayerConfig.CurrentValue.Shuffle
        };

        await JS.InvokeVoidAsync("musicPlayer.init", config, _dotnetRef);
        await JS.InvokeVoidAsync("musicPlayer.initSliders");
    }

    private async Task ToggleExpand()
    {
        _expanded = !_expanded;
        if (_expanded)
            await JS.InvokeVoidAsync("musicPlayer.initSliders");
    }

    private async Task Toggle() =>
        await JS.InvokeVoidAsync("musicPlayer.toggle");

    private async Task Next() =>
        await JS.InvokeVoidAsync("musicPlayer.next");

    private async Task Prev() =>
        await JS.InvokeVoidAsync("musicPlayer.prev");

    private async Task ToggleShuffle()
    {
        _shuffle = !_shuffle;
        await JS.InvokeVoidAsync("musicPlayer.setShuffle", _shuffle);
    }

    private async Task SelectTrack(int index) =>
        await JS.InvokeVoidAsync("musicPlayer.selectTrack", index);

    [JSInvokable]
    public async void OnTimeUpdate(double currentTime, double duration)
    {
        _currentTime = currentTime;
        _duration = duration;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnPlayStateChanged(bool isPlaying)
    {
        _isPlaying = isPlaying;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnTrackChanged(int index)
    {
        _currentIndex = index;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async void OnTracksLoaded(string json)
    {
        var tracks = System.Text.Json.JsonSerializer.Deserialize
            <List<TrackInfo>>(json,
            new System.Text.Json.JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });

        if (tracks is not null)
        {
            _tracks = tracks;
            _visible = _tracks.Count > 0;
        }

        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("musicPlayer.initSliders");
    }

    private static string FormatTime(double seconds)
    {
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.Hours > 0
            ? ts.ToString(@"h\:mm\:ss")
            : ts.ToString(@"m\:ss");
    }

    public async ValueTask DisposeAsync()
    {
        _dotnetRef?.Dispose();
        try { await JS.InvokeVoidAsync("musicPlayer.destroy"); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }

    public class TrackInfo
    {
        public string Url { get; set; } = "";
        public string Title { get; set; } = "";
        public string Artist { get; set; } = "";
        public string Album { get; set; } = "";
        public string? Cover { get; set; }
    }
}